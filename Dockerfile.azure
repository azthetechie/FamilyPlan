# syntax=docker/dockerfile:1.6
#
# Nest — Single-container image for Azure Web App for Containers.
# Runs nginx (serving SPA + proxying /api) and uvicorn (FastAPI) under supervisord.
# Azure App Service injects $PORT (default 8080); nginx binds to that.

# -------- Stage 1: Build React SPA --------
FROM node:22-alpine AS frontend

WORKDIR /src/frontend
COPY frontend/package.json frontend/yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 120000

# Empty REACT_APP_BACKEND_URL → SPA uses relative "/api/..." paths,
# which the same container's nginx proxies to uvicorn.
ARG REACT_APP_BACKEND_URL=""
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL

COPY frontend/ ./
RUN yarn build


# -------- Stage 2: Runtime (Python + nginx + supervisord) --------
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8080 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        nginx supervisor curl gettext-base ca-certificates \
 && rm -rf /var/lib/apt/lists/* /var/log/nginx/* \
 && mkdir -p /var/log/supervisor

# Backend deps and code
WORKDIR /app/backend
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --upgrade pip && pip install -r /app/backend/requirements.txt
COPY backend /app/backend

# SPA static files
COPY --from=frontend /src/frontend/build /usr/share/nginx/html

# Process & web server config
COPY deploy/azure/nginx.conf.template /etc/nginx/nginx.conf.template
COPY deploy/azure/supervisord.conf /etc/supervisor/supervisord.conf
COPY deploy/azure/startup.sh /startup.sh
RUN chmod +x /startup.sh \
 && rm -f /etc/nginx/sites-enabled/default /etc/nginx/conf.d/default.conf

# Azure Web App for Containers will route the public TLS port to $PORT (default 8080).
EXPOSE 8080

# Quick container-level healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:${PORT:-8080}/healthz || exit 1

CMD ["/startup.sh"]
